# Create a Clerk app. In Clerk, add JWT template named convex.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
# Generated by `npx convex dev` (do not commit .env.local).
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
# Create a Notion internal integration; grant it access to your target parent page.
NOTION_INTEGRATION_TOKEN=
NOTION_PARENT_PAGE_ID=
